# Copy to docker-compose.staging.env and replace every value before use.
# Hostnames must be HTTPS names with a DNS label containing "staging", in a
# staging-owned DNS domain outside the RTC production suffixes.
MOODLE_STAGING_HOSTNAME=moodle.staging.example.invalid
# Copy these canonical origins from the shared GitHub organization variables.
RTC_STAGING_MOODLE_ORIGIN=https://moodle.staging.example.invalid
RTC_STAGING_API_ORIGIN=https://api.staging.example.invalid
# Must match RTC_STAGING_API_ORIGIN. The SSO client appends /api/auth/get_detail_user.
RTC_STAGING_API_BASE_URL=https://api.staging.example.invalid

# Use unique, generated credentials. The two database passwords and salt must
# each be 64 hexadecimal characters; never reuse production credentials.
MOODLE_STAGING_DB_NAME=moodle_staging
MOODLE_STAGING_DB_USER=moodle_staging_user
MOODLE_STAGING_DB_PASSWORD=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
MOODLE_STAGING_DB_ROOT_PASSWORD=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
MOODLE_STAGING_PASSWORD_SALT=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc

# Copy LMS_DB_HOST_PORT from the backend GitHub staging environment. Keep both
# Moodle ports distinct from that backend staging MySQL port and all host services.
LMS_DB_HOST_PORT=13312
MOODLE_STAGING_DB_PORT=13313
MOODLE_STAGING_WEB_PORT=18081
